{
  "name": "fitgate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:chrome",
    "dev:chrome": "npm run dev --workspace=fitgate-extension",
    "dev:macos": "npm start --workspace=fitgate-macos",
    "build": "npm run build:chrome && npm run build:macos",
    "build:chrome": "npm run build --workspace=fitgate-extension",
    "build:macos": "npm run build --workspace=fitgate-macos",
    "test": "npm run test --workspaces --if-present",
    "smoke:macos": "npm run smoke --workspace=fitgate-macos",
    "smoke:startup": "npm run smoke:startup --workspace=fitgate-macos",
    "package:macos": "npm run package --workspace=fitgate-macos",
    "smoke:chrome": "npm run smoke --workspace=fitgate-extension",
    "release:macos": "npm run package:release --workspace=fitgate-macos"
  }
}
